# Copy to .env.local and fill in. `npm run init-config` in /contracts prints these values.

# RPC endpoint the app talks to. Devnet public RPC works but is rate-limited;
# a free Helius/QuickNode devnet URL is smoother for demos.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# devnet | localnet | mainnet-beta  (used for Solana Explorer links)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Your deployed program ID (from `anchor keys list`). If empty, the address in
# src/idl/ghost_checkout.json is used.
NEXT_PUBLIC_PROGRAM_ID=

# No WalletConnect key needed: Solana wallets (Phantom, Solflare, Backpack…)
# are auto-detected through the Wallet Standard.
