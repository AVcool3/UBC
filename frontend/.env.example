# Copy to .env.local. Public identifiers (program, market, maker, mints) are
# pinned in src/deployment.json by `npm run seed-market` (in /contracts), so you
# normally only need the RPC + demo keys. `npm run demo-env` prints all of these.

# RPC endpoint. The public devnet RPC works but is rate-limited; a free
# Helius/QuickNode devnet URL is smoother for demos.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Demo mode: no-install demo wallet, test-USDC faucet, labelled "simulate a reprice".
NEXT_PUBLIC_DEMO_MODE=true

# SERVER-ONLY test keys (JSON arrays of 64 numbers). Never NEXT_PUBLIC_.
# DEMO_FAUCET_KEY: mint authority of the test USDC.  DEMO_MAKER_KEY: the test maker
# (falls back to the first key of DEMO_SELLER_KEYS for older deployments).
DEMO_FAUCET_KEY=
DEMO_MAKER_KEY=

# Optional overrides of the pinned identifiers (leave empty normally).
NEXT_PUBLIC_HELD_PROGRAM_ID=
NEXT_PUBLIC_HELD_MARKET=
NEXT_PUBLIC_HELD_MAKER=
NEXT_PUBLIC_HELD_COLLATERAL_MINT=
